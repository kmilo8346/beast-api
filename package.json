{
  "name": "beast-api",
  "version": "1.0.4",
  "description": "",
  "main": "src/index.ts",
  "scripts": {
    "build": "rm -rf build && npx tsc",
    "dev": "npm run init && npx nodemon --watch 'src' --ignore 'src/**/*.spec.ts' --exec 'npx ts-node  -r dotenv-safe/config' src/index.ts dotenv_config_path=${ENV_PATH} | pino-pretty --messageKey message --ignore pid,hostname,name",
    "start": "node -r dotenv-safe/config build/src/index.js | npx pino-stackdriver-mapper",
    "gcp-build": "npm run build",
    "commit": "git commit -m \"ci(api)\" --allow-empty",
    "test": "k6 run ./tests/script.js",
    "init": "npx ts-node -r dotenv-safe/config src/init/index.ts dotenv_config_path=${ENV_PATH} | pino-pretty --messageKey message --ignore pid,hostname,name",
    "publish": "npx standard-version --release-as patch && git push --follow-tags origin master && npm publish"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/firedevs-team/beast-api.git"
  },
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/firedevs-team/beast-api/issues"
  },
  "homepage": "https://github.com/firedevs-team/beast-api#readme",
  "dependencies": {
    "@elastic/elasticsearch": "^7.7.1",
    "@google-cloud/pubsub": "^2.3.0",
    "@hapi/joi": "^17.1.1",
    "axios": "^0.19.2",
    "dotenv-safe": "^8.2.0",
    "expo-server-sdk": "^3.5.1",
    "firebase-admin": "^8.12.1",
    "form-data": "^3.0.0",
    "koa": "^2.12.0",
    "koa-body": "^4.1.3",
    "koa-conditional-get": "^2.0.0",
    "koa-etag": "^3.0.0",
    "koa-json": "^2.0.2",
    "koa-pino-logger": "^3.0.0",
    "koa-qs": "^3.0.0",
    "koa-router": "^9.0.1",
    "lodash": "^4.17.15",
    "mercadopago": "^1.3.1",
    "moment": "^2.27.0",
    "pino": "^6.4.1",
    "pino-pretty": "^4.1.0",
    "pino-stackdriver-mapper": "^1.0.1",
    "standard-version": "^9.0.0",
    "twilio": "^3.47.0",
    "uuid": "^8.2.0",
    "verror": "^1.10.0"
  },
  "devDependencies": {
    "@types/dotenv-safe": "^8.1.0",
    "@types/hapi__joi": "^17.1.2",
    "@types/koa-conditional-get": "^2.0.0",
    "@types/koa-etag": "^3.0.0",
    "@types/koa-json": "^2.0.18",
    "@types/koa-pino-logger": "^2.1.6",
    "@types/koa-qs": "^2.0.0",
    "@types/koa-router": "^7.4.1",
    "@types/lodash": "^4.14.155",
    "@types/pino": "^6.3.0",
    "@types/uuid": "^8.0.0",
    "@types/verror": "^1.10.4",
    "@typescript-eslint/eslint-plugin": "^3.2.0",
    "@typescript-eslint/parser": "^3.2.0",
    "eslint": "^6.8.0",
    "eslint-config-airbnb-base": "^14.1.0",
    "eslint-config-prettier": "^6.11.0",
    "eslint-plugin-import": "^2.21.1",
    "eslint-plugin-prettier": "^3.1.3",
    "nodemon": "^2.0.4",
    "prettier": "^2.0.5",
    "ts-node": "^8.10.2",
    "typescript": "^3.9.5"
  },
  "engines": {
    "node": "12.x.x"
  }
}
