    "moment": "^2.27.0",
    "pino": "^6.4.1",
    "pino-pretty": "^4.1.0",
    "pino-stackdriver-mapper": "^1.0.1",
    "twilio": "^3.47.0",
    "uuid": "^8.2.0",
    "verror": "^1.10.0"
  },
  "devDependencies": {
    "@types/dotenv-safe": "^8.1.0",
    "@types/hapi__joi": "^17.1.2",
    "@types/koa-json": "^2.0.18",
    "@types/koa-pino-logger": "^2.1.6",
    "@types/koa-router": "^7.4.1",
    "@types/lodash": "^4.14.155",
    "@types/pino": "^6.3.0",
    "@types/uuid": "^8.0.0",
