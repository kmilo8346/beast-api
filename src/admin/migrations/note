execute script
npx ts-node -r dotenv-safe/config src/admin/migrations/{script} dotenv_config_path=${ENV_PATH} | npx pino-pretty --messageKey message --ignore pid,hostname,name


modify_users_index

export ENV_PATH=.env.production
npx ts-node -r dotenv-safe/config src/admin/migrations/modify_users_index.ts dotenv_config_path=${ENV_PATH} | npx pino-pretty --messageKey message --ignore pid,hostname,name
unset ENV_PATH
npx ts-node -r dotenv-safe/config src/admin/migrations/modify_users_index.ts dotenv_config_path=${ENV_PATH} | npx pino-pretty --messageKey message --ignore pid,hostname,name

